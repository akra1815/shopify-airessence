{"sections":{"main":{"type":"main-product","blocks":{"vendor":{"type":"text","disabled":true,"settings":{"text":"{{ product.vendor }}","text_style":"uppercase"}},"title":{"type":"title","settings":{}},"price":{"type":"price","settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button"}},"quantity_selector":{"type":"quantity_selector","disabled":true,"settings":{}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"show_gift_card_recipient":false}},"description":{"type":"description","settings":{}},"share":{"type":"share","disabled":true,"settings":{"share_label":"Share"}},"4aefb5e4-81b0-4ce0-9f6b-d58aa20bf428":{"type":"collapsible_tab","disabled":true,"settings":{"heading":"Substances utilisées","icon":"bottle","content":"<p>Tous les parfums utilisés sont issus de parfumeries de Grasse, ville française <strong>mondialement reconnue </strong>dans le domaine.</p><p>Nos sent-bon sont <strong>sans danger</strong> au niveau respiratoire. Toutes les essences sont <strong>certifiées sans substances CMR </strong>(Cancérigène, Mutagène, Reprotoxique), sans phtalate et sans matière animale.</p>","page":""}},"da04ba20-e851-4a86-9b59-9091c8fffffc":{"type":"collapsible_tab","disabled":true,"settings":{"heading":"Dimensions des formes","icon":"ruler","content":"<p><strong>Carré</strong> : 9.5 x 9.5 cm<br/><strong>Rond</strong> : diamètre 8.8 cm<br/><strong>Rectangle vertical </strong>: 10 x 7.5 cm<br/><strong>Rectangle horizontal </strong>: 7,5 x 10 cm</p>","page":""}},"3d6d9eea-acbf-4c64-9271-59432ecfdb13":{"type":"collapsible_tab","disabled":true,"settings":{"heading":"Recycle ton sent-bon","icon":"recycle","content":"<p>Nous privilégions une consommation responsable en proposant des <strong>recharges de parfum</strong>. Évite le gaspillage et<strong> donne une nouvelle vie </strong>à ton sent-bon en le parfumant à nouveau.</p>","page":""}},"d24cd892-1e97-4e0c-86ae-ff28ed8c3060":{"type":"collapsible_tab","disabled":true,"settings":{"heading":"Informations sur la livraison","icon":"truck","content":"<p>Nous livrons <strong>partout en Europe et en Suisse.</strong></p><p>Les délais de livraison dépendent du mode de livraison choisi :</p><p><strong>Standard : 5-7 jours ouvrés<br/>Express : 3-4 jours ouvrés</strong></p>","page":""}},"b4db7bcd-57c3-40a8-8c1d-f504c4b850da":{"type":"custom_liquid","settings":{"custom_liquid":"<style>\n    .step {\n        font-size: 14px; \n    }\n</style>\n<div style=\"text-align: center; font-size: 16px; margin-bottom: 0px; font-weight:600; font-style:italic;color: #2E2A39;text-decoration: underline;\n  text-decoration-color: #65ddc6;\n  text-decoration-thickness: 3px;\n  text-underline-offset: 3px;\">\n    PROCESSUS DE LIVRAISON\n</div>\n<span class=\"template_order\" style=\"display: inline-flex;width: 100%;border: none;border-radius:10px;padding: 0px 0;font-size: 15px;color: #000;\">\n        <!-- Commandé -->\n        <span class=\"li_border step\" style=\"flex: 1; position: relative; list-style: none;text-align: center; line-height:20px;\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"sb_steps_svg_icon\" style=\"fill: #00b894;width: 45px; height: 45px; background:#ffffff; padding: 7px; display: inline-block;color:#1d1d1d; font-size: 20px;\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                <path d=\"M11.354 6.354a.5.5 0 0 0-.708-.708L8 8.293 6.854 7.146a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0l3-3z\"></path>\n                <path d=\"M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1H.5zm3.915 10L3.102 4h10.796l-1.313 7h-8.17zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z\"></path>\n            </svg>\n            <br>\n            <b><span> Commandé</span><br></b>\n            <span class=\"3_step_1_date\">\n                <font color=\"#424242\" style=\"\">\n                    <span class=\"hightlight_date\" id=\"dateCommande\"></span>\n                </font>\n            </span>\n        </span>\n\n        <!-- Expédié -->\n        <span class=\"li_border step\" style=\"flex: 1; position: relative; list-style: none;text-align: center;line-height:20px;\">\n            <svg class=\"sb_steps_svg_icon\" style=\"color: #00b894; font-size: 20px; fill: currentColor; width: 45px; height: 45px; background:#ffffff; padding: 7px; display: inline-block;\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\">\n                <path fill=\"var(--ci-primary-color, currentColor)\" d=\"M441.885,141.649A32.028,32.028,0,0,0,415.669,128H336V80a32.036,32.036,0,0,0-32-32H48A32.036,32.036,0,0,0,16,80V408H69.082a67.982,67.982,0,0,0,133.836,0H309.082a67.982,67.982,0,0,0,133.836,0H496V226.522a23.882,23.882,0,0,0-4.338-13.763ZM47.98,80H304V256H48ZM136,432a36,36,0,1,1,36-36A36.04,36.04,0,0,1,136,432Zm240,0a36,36,0,1,1,36-36A36.04,36.04,0,0,1,376,432Zm88-56H440.994a68,68,0,0,0-129.988,0H200.994a68,68,0,0,0-129.988,0H48V288H464Zm0-120H336V160h79.669L464,229.044Z\" class=\"ci-primary\"></path>\n            </svg>\n            <br>\n            <b><span> Fabriqué, expédié </span><br></b>\n            <font color=\"#424242\" style=\"\">\n                <span class=\"hightlight_date\" id=\"dateExpedie\"></span>\n            </font>\n        </span>\n\n        <!-- Livré -->\n        <span class=\"li_border_1 step\" style=\"flex: 1.5; position: relative; list-style: none;text-align: center;line-height:20px;\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" class=\"sb_steps_svg_icon\" style=\"color: #00b894; font-size: 20px;fill: currentColor; width: 45px; height: 45px; background:#ffffff; padding: 7px; display: inline-block;\">\n                <path d=\"M12 0c-5.522 0-10 4.395-10 9.815 0 5.505 4.375 9.268 10 14.185 5.625-4.917 10-8.68 10-14.185 0-5.42-4.478-9.815-10-9.815zm0 18c-4.419 0-8-3.582-8-8s3.581-8 8-8 8 3.582 8 8-3.581 8-8 8zm5-9.585l-5.708 5.627-3.706-3.627 1.414-1.415 2.291 2.213 4.295-4.213 1.414 1.415z\"></path>\n            </svg>\n            <br>\n            <b><span> Livré</span><br></b>\n            <span>\n                <font color=\"#424242\" style=\"\">\n                    <span class=\"hightlight_date\" id=\"dateLivraison\"></span>\n                </font>\n            </span>\n        </span>\n    </span>\n\n    <script>\n        // Fonction pour ajouter un nombre de jours ouvrables à une date\n        function addBusinessDays(date, days) {\n            const startDate = new Date(date.getTime());\n            let count = 0;\n\n            while (count < days) {\n                startDate.setDate(startDate.getDate() + 1);\n\n                // Vérifier si la date est un jour ouvrable (lundi à vendredi)\n                if (startDate.getDay() !== 0 && startDate.getDay() !== 6) {\n                    count++;\n                }\n            }\n\n            return startDate;\n        }\n\n        // Obtenir la date du jour\n        const today = new Date();\n\n        // Calculer la date d'expédition (jour actuel + 3 jours ouvrables)\n        const expedieDate = addBusinessDays(today, 3);\n\n        // Calculer la date de livraison pour la livraison Standard (jour actuel + 7 à 8 jours ouvrables)\nconst livraisonStandardStartDate = addBusinessDays(today, 7);\nconst livraisonStandardEndDate = addBusinessDays(today, 8);\n\n// Calculer la date de livraison pour la livraison Express (jour actuel + 4 à 6 jours ouvrables)\nconst livraisonExpressStartDate = addBusinessDays(today, 4);\nconst livraisonExpressEndDate = addBusinessDays(today, 6);\n\n      // Mettre à jour les éléments HTML avec les dates calculées\ndocument.getElementById('dateCommande').textContent = formatDate(today);\ndocument.getElementById('dateExpedie').textContent = formatDate(expedieDate);\ndocument.getElementById('dateLivraison').innerHTML =\n    `<span style=\"font-size: 14px; color: #424242; \">Express  : ${formatDate(livraisonExpressStartDate)} - ${formatDate(livraisonExpressEndDate)}</span><br><span style=\"font-size: 14px; color: #424242;\">Standard : ${formatDate(livraisonStandardStartDate)} - ${formatDate(livraisonStandardEndDate)}</span>`;\n\n        // Fonction pour formater la date en format \"dd MMM\"\n        function formatDate(date) {\n            const options = { day: 'numeric', month: 'short' };\n            return date.toLocaleDateString('fr-FR', options);\n        }\n    </script>"}},"air-essence-review-summary":{"type":"custom_liquid","settings":{"custom_liquid":"{% render 'air-essence-review-summary', product: product %}"}}},"block_order":["vendor","title","price","air-essence-review-summary","variant_picker","quantity_selector","buy_buttons","description","share","4aefb5e4-81b0-4ce0-9f6b-d58aa20bf428","da04ba20-e851-4a86-9b59-9091c8fffffc","3d6d9eea-acbf-4c64-9271-59432ecfdb13","d24cd892-1e97-4e0c-86ae-ff28ed8c3060","b4db7bcd-57c3-40a8-8c1d-f504c4b850da"],"custom_css":["div .product__accordion {max-width: 44rem; width: 100%; border-top: solid 1px #a9a9a9; border-bottom: solid 1px #a9a9a9; padding-left: 20px;}",".product__accordion h2 {font-size: 16px; align-self: center;}",".product__accordion summary {}",".accordion__content {padding-left: 0;}",".accordion__content p {font-size: 14px;}","h3 {text-decoration: underline; text-decoration-color: #65ddc6; text-decoration-thickness: 5px; text-underline-offset: 3px;}"],"settings":{"enable_sticky_info":true,"media_size":"small","constrain_to_viewport":true,"media_fit":"contain","gallery_layout":"thumbnail_slider","media_position":"left","image_zoom":"none","mobile_thumbnails":"hide","hide_variants":false,"enable_video_looping":false,"padding_top":48,"padding_bottom":12}},"related-products":{"type":"related-products","disabled":true,"settings":{"heading":"You may also like","heading_size":"h2","products_to_sho