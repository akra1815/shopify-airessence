or: #00b894; font-size: 20px;fill: currentColor; width: 45px; height: 45px;  padding: 7px; display: inline-block;\">\n                <path d=\"M12 0c-5.522 0-10 4.395-10 9.815 0 5.505 4.375 9.268 10 14.185 5.625-4.917 10-8.68 10-14.185 0-5.42-4.478-9.815-10-9.815zm0 18c-4.419 0-8-3.582-8-8s3.581-8 8-8 8 3.582 8 8-3.581 8-8 8zm5-9.585l-5.708 5.627-3.706-3.627 1.414-1.415 2.291 2.213 4.295-4.213 1.414 1.415z\"></path>\n            </svg>\n            <br>\n            <b><span> Livré</span><br></b>\n            <span>\n                <font color=\"#424242\" style=\"\">\n                    <span class=\"hightlight_date\" id=\"dateLivraison\"></span>\n                </font>\n            </span>\n        </span>\n    </span>\n</div>\n\n    <script>\n        // Fonction pour ajouter un nombre de jours ouvrables à une date\n        function addBusinessDays(date, days) {\n            const startDate = new Date(date.getTime());\n            let count = 0;\n\n            while (count < days) {\n                startDate.setDate(startDate.getDate() + 1);\n\n                // Vérifier si la date est un jour ouvrable (lundi à vendredi)\n                if (startDate.getDay() !== 0 && startDate.getDay() !== 6) {\n                    count++;\n                }\n            }\n\n            return startDate;\n        }\n\n        // Obtenir la date du jour\n        const today = new Date();\n\n        // Calculer la date d'expédition (jour actuel + 2 jours ouvrables)\n        const expedieDate = addBusinessDays(today, 2);\n\n        // Calculer la date de livraison pour la livraison Standard (jour actuel + 6 à 7 jours ouvrables)\nconst livraisonStandardStartDate = addBusinessDays(today, 6);\nconst livraisonStandardEndDate = addBusinessDays(today, 7);\n\n// Calculer la date de livraison pour la livraison Express (jour actuel + 4 à 5 jours ouvrables)\nconst livraisonExpressStartDate = addBusinessDays(today, 4);\nconst livraisonExpressEndDate = addBusinessDays(today, 5);\n\n      // Mettre à jour les éléments HTML avec les dates calculées\ndocument.getElementById('dateCommande').textContent = formatDate(today);\ndocument.getElementById('dateExpedie').textContent = formatDate(expedieDate);\ndocument.getElementById('dateLivraison').innerHTML =\n    `<span style=\"color: #424242; \"><a style=\"text-decoration: underline;\n  text-decoration-color: #65ddc6;\n  text-decoration-thickness: 2px;\n  text-underline-offset: 2px;\">Express</a> ${formatDate(livraisonExpressStartDate)} - ${formatDate(livraisonExpressEndDate)}</span><br><span style=\"color: #424242;\"><a style=\"text-decoration: underline;\n  text-decoration-color: #65ddc6;\n  text-decoration-thickness: 2px;\n  text-underline-offset: 2px;\">Standard</a> ${formatDate(livraisonStandardStartDate)} - ${formatDate(livraisonStandardEndDate)}</span>`;\n\n        // Fonction pour formater la date en format \"dd MMM\"\n        function formatDate(date) {\n            const options = { day: 'numeric', month: 'short' };\n            return date.toLocaleDateString('fr-FR', options);\n        }\n    </script>"}},"description":{"type":"description","disabled":true,"settings":{}},"share":{"type":"share","disabled":true,"settings":{"share_label":"Share"}},"4aefb5e4-81b0-4ce0-9f6b-d58aa20bf428":{"type":"collapsible_tab","disabled":true,"settings":{"heading":"Substances utilisées","icon":"bottle","content":"<p>Tous les parfums utilisés sont issus de parfumeries de Grasse, ville française <strong>mondialement reconnue </strong>dans le domaine.</p><p>Nos sent-bon sont <strong>sans danger</strong> au niveau respiratoire. Toutes les essences sont <strong>certifiées sans substances CMR </strong>(Cancérigène, Mutagène, Reprotoxique), sans phtalate et sans matière animale.</p>","page":""}},"da04ba20-e851-4a86-9b59-9091c8fffffc":{"type":"collapsible_tab","disabled":true,"settings":{"heading":"Dimensions des formes","icon":"ruler","content":"<p><strong>Carré</strong> : 9.5 x 9.5 cm<br/><strong>Rond</strong> : diamè